# ==========================================
# Google Photos Sync Manager - Configuration
# ==========================================
#
# This file is loaded by docker-compose.yml (env_file directive) and passed
# to the web GUI container. All variables have sensible defaults — you only
# need to change the ones relevant to your setup.
#
# Copy .env.example to .env and edit as needed:
#   cp .env.example .env
#
# After changing values, restart the stack:
#   docker compose up -d
#

# --- Authentication (optional) ---
# Set both to enable HTTP Basic Auth on the web GUI.
# Leave empty or commented out for open access (default).
#AUTH_USERNAME=
#AUTH_PASSWORD=

# --- Web GUI ---

# Prefix used when naming sync containers and their docker-compose files.
# Each profile creates a container named <CONTAINER_PREFIX>-<profile-name>.
# Example: with "gphotos-sync" a profile "john" creates container "gphotos-sync-john".
CONTAINER_PREFIX=gphotos-sync

# Host port where the web GUI is accessible.
# The container always listens on 8080 internally; this controls the host mapping.
# Example: set to 9090 to access the GUI at http://localhost:9090
WEB_GUI_PORT=8080

# --- Default values for new profiles ---
# These values are pre-filled when creating a new sync profile from the GUI.
# Each profile can override them individually in its own docker-compose file.

# IANA timezone for the sync container (affects cron scheduling and log timestamps).
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DEFAULT_TIMEZONE=Europe/Rome

# Cron expression defining when automatic sync runs.
# Format: minute hour day-of-month month day-of-week
# Examples:
#   0 3 * * *     = every day at 03:00
#   0 */6 * * *   = every 6 hours
#   0 3 * * 1     = every Monday at 03:00
DEFAULT_CRON_SCHEDULE=0 3 * * *

# Number of parallel download workers per sync container (1-20).
# Higher values download faster but use more memory and CPU.
# Recommended: 3-6 for low-end machines, 6-12 for powerful ones.
DEFAULT_WORKER_COUNT=6

# Log verbosity level for the sync engine.
# Available levels: error, warn, info, debug
# Use "debug" for troubleshooting, "info" for normal operation.
DEFAULT_LOGLEVEL=info

# Download method for the sync engine.
# "compressed" = Shift+D shortcut (Google's compressed version, default)
# "original"   = Direct URL extraction (original quality, universal timestamps)
DEFAULT_DOWNLOAD_METHOD=compressed

# Whether to run a sync immediately when the container starts (true/false).
# If false, the first sync will happen at the next cron schedule.
DEFAULT_RUN_ON_STARTUP=true

# --- User/Group IDs (file ownership) ---

# Linux user ID and group ID applied to downloaded files.
# Set these to match your host user so files are accessible without sudo.
# Find your IDs by running: id -u (PUID) and id -g (PGID)
PUID=1000
PGID=1000

# --- VNC viewer for sync containers ---

# Enable a VNC server inside each sync container (true/false).
# When enabled, you can watch the headless Chrome browser in real time
# through the web GUI. Useful for debugging but uses extra resources.
DEFAULT_ENABLE_VNC=false

# First host port assigned to sync container VNC servers.
# Each profile gets an incremental port: first profile = 6081, second = 6082, etc.
# Port 6080 is reserved for the auth container's VNC.
VNC_PORT_START=6081
